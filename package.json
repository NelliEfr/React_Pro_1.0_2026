{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundleSize": "vite-bundle-visualizer -c ./vite.config.js",
    "check:updates": "ncu",
    "fix:eslint": "eslint --fix --ext .ts,.tsx ./src --max-warnings 0",
    "fix:prettier": "prettier --ignore-path .gitignore \"./src/**/*.{ts,tsx,scss,sass,css,md,mdx}\" --write",
    "fix:stylelint": "stylelint --fix \"./src/**/*.{scss,sass,css}\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "engines": {
    "node": "v24.14.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npm run fix:eslint"
    ],
    "src/**/*.{ts,tsx,scss,sass,css,md,mdx}": [
      "npm run fix:prettier"
    ],
    "src/**/*.{scss,sass,css}": [
      "npm run fix:stylelint"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@tanstack/react-query": "5.90.21",
    "@zh2s/react-utils": "1.0.5",
    "ky": "1.14.3",
    "react": "19.2.4",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "react-router": "7.13.1",
    "react-toastify": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@feature-sliced/eslint-config": "0.1.1",
    "@types/node": "25.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "@vitejs/plugin-react": "5.1.4",
    "@zh2s/eslint-config-fsd": "1.0.1",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "5.4.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "npm-check-updates": "19.6.3",
    "prettier": "3.8.1",
    "sass-embedded": "1.98.0",
    "stylelint": "17.6.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "7.3.1",
    "vite-bundle-visualizer": "1.2.1",
    "vite-tsconfig-paths": "6.1.1"
  }
}
